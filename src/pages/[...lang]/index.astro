---
import Base from '../../layouts/Base.astro';
import FlowChart from '../../components/FlowChart.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { langPaths, localize, type Lang } from '../../i18n';
import { HOME } from '../../i18n/home';
import { ui } from '../../i18n/ui';
import { recipesFor } from '../../i18n/content';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const c = HOME[lang];
const t = ui(lang);

const recipes = (await recipesFor(lang)).filter((r) => r.data.featured).slice(0, 3);
const reading = await getCollection('reading');
const nowReading = reading.find((r) => r.data.current);
const shelf = reading.filter((r) => r.data.kind === 'book').slice(0, 6);
const now = c.now.map((n, i) =>
  i === c.now.length - 1
    ? { ...n, v: nowReading ? c.nowReading(nowReading.data.title, nowReading.data.author) : c.nowReadingFallback }
    : n,
);

const spineColors = ['#2231d1', '#e2ee4a', '#0d0f30', '#7fd1a8', '#8f99ff', '#e6e5dc'];
const spineInk = ['#eef0ff', '#1a1d00', '#eef0ff', '#0d0f30', '#0d0f30', '#0d0f30'];
---
<Base lang={lang}>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="hero-kicker">
        <span class="status"><span class="pulse" aria-hidden="true"></span>{c.statusAt} {SITE.company}</span>
      </p>
      <h1>{c.h1Before}<span class="flow-word">{c.h1Flow}</span>{c.h1After}</h1>
    </div>
    <div class="hero-side">
      <p class="hero-lead" set:html={c.leadHtml} />
      <dl class="now">
        {now.map((n) => (
          <div><dt class="label">{n.k}</dt><dd>{n.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FLOW CHART -->
  <section class="wrap" aria-labelledby="flow-title">
    <FlowChart copy={c.flow} />
  </section>

  <!-- IMPACT -->
  <section id="work" class="section wrap">
    <div class="section-head">
      <span class="section-num">{c.impact.kicker}</span>
      <h2>{c.impact.h2}</h2>
      <p class="section-lead">{c.impact.lead}</p>
    </div>
    <div class="ledger">
      {c.impact.items.map((i) => (
        <article class="ledger-row">
          <p class="stat">{i.stat}</p>
          <div>
            <h3>{i.label}</h3>
            <p>{i.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- AI -->
  <section id="ai" class="ai">
    <div class="wrap">
      <div class="ai-head">
        <span class="section-num on-blue">{c.ai.kicker}</span>
        <h2 set:html={c.ai.h2Html} />
        {c.ai.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <ol class="pipe">
        {c.ai.pipeline.map((p, idx) => (
          <li class:list={['pipe-step', p.whoKey]}>
            <span class="pipe-n">{String(idx + 1).padStart(2, '0')}</span>
            <span class="pipe-who">{p.who}</span>
            <h3>{p.step}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- MANUAL -->
  <section id="manual" class="section wrap">
    <div class="manual">
      <div class="manual-side">
        <span class="section-num">{c.manual.kicker}</span>
        <h2>{c.manual.h2}</h2>
        <p class="section-lead">{c.manual.lead}</p>
      </div>
      <ol class="manual-list">
        {c.manual.items.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- EXPERIENCE + TEACHING -->
  <section id="experience" class="section wrap">
    <div class="section-head">
      <span class="section-num">{c.experience.kicker}</span>
      <h2>{c.experience.h2}</h2>
    </div>
    <div class="cv">
      <table class="jobs">
        <tbody>
          {c.experience.jobs.map((j) => (
            <tr>
              <td class="label yrs">{j.years}</td>
              <th scope="row">{j.org}</th>
              <td class="role">{j.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <aside class="cv-side">
        <div class="teach card">
          <span class="tag">{c.experience.teachTag}</span>
          <p set:html={c.experience.teachHtml} />
        </div>
        <h3 class="side-h">{c.experience.educationH}</h3>
        <ul class="edu">
          {c.experience.education.map((e) => (
            <li><strong>{e.role}</strong><span class="label">{e.org} · {e.years}</span></li>
          ))}
        </ul>
        <h3 class="side-h">{c.experience.writingH}</h3>
        <ul class="edu">
          {c.experience.notes.map((n) => (
            <li><strong>{n.title}</strong><span class="label">{n.kind} · {c.experience.inDraft}</span></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <!-- OFF THE CLOCK -->
  <section id="off" class="section wrap">
    <div class="section-head">
      <span class="section-num">{c.off.kicker}</span>
      <h2>{c.off.h2}</h2>
      <p class="section-lead">{c.off.lead}</p>
    </div>
    <div class="off">
      <div>
        <div class="off-head">
          <h3>{c.off.kitchen}</h3>
          <a class="link label" href={localize(lang, '/recipes/')}>{c.off.allRecipes}</a>
        </div>
        <div class="recipes">
          {recipes.map((r, i) => (
            <a class="card recipe" href={localize(lang, `/recipes/${r.slug}/`)} style={`--tilt:${[-1, 0.6, -0.4][i % 3]}deg`}>
              <span class="tag">{r.data.tag}</span>
              <h4>{r.data.title}</h4>
              <p>{r.data.summary}</p>
              <span class="label">{r.data.time} · {t.serves(r.data.serves)}</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="off-head">
          <h3>{c.off.shelf}</h3>
          <a class="link label" href={localize(lang, '/reading/')}>{c.off.readingList}</a>
        </div>
        <a class="shelf" href={localize(lang, '/reading/')} aria-label={c.off.shelfAria}>
          {shelf.map((b, i) => (
            <span class="spine" style={`--c:${spineColors[i % 6]};--t:${spineInk[i % 6]};--h:${[92, 80, 100, 86, 95, 78][i % 6]}%`}>
              <span>{b.data.title}</span>
            </span>
          ))}
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero {
    display: grid;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 56px;
  }
  @media (min-width: 980px) {
    .hero { grid-template-columns: 1.35fr 1fr; gap: 64px; align-items: end; padding-top: 88px; }
  }
  .hero-kicker { margin: 0 0 24px; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.88rem;
    padding: 6px 14px 6px 10px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
  }
  .pulse {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--mint);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--mint) 70%, transparent); }
    70% { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  h1 {
    font-size: clamp(2.7rem, 1.2rem + 5.4vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.98;
    margin: 0;
  }
  .flow-word { position: relative; color: var(--blue); white-space: nowrap; }
  .hero-lead { margin: 0 0 28px; font-size: 1.12rem; color: var(--ink-2); }
  .hero-lead strong { color: var(--ink); font-weight: 600; }
  .now { margin: 0; border-top: 1.5px solid var(--ink); }
  .now div {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .now dt { text-transform: uppercase; letter-spacing: 0.1em; padding-top: 3px; }
  .now dd { margin: 0; }

  /* IMPACT */
  .ledger { display: grid; border-top: 1.5px solid var(--ink); }
  @media (min-width: 820px) { .ledger { grid-template-columns: 1fr 1fr; column-gap: 56px; } }
  .ledger-row {
    display: grid;
    grid-template-columns: minmax(96px, 0.6fr) 1fr;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .stat {
    margin: 0;
    font-family: var(--display);
    font-weight: 750;
    font-size: clamp(3rem, 2rem + 3vw, 4.6rem);
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--blue);
  }
  .ledger-row h3 { margin: 4px 0 8px; font-size: 1.25rem; }
  @media (max-width: 520px) { .ledger-row { grid-template-columns: 84px 1fr; gap: 14px; } .stat { font-size: 2.6rem; } }
  .ledger-row p:not(.stat) { margin: 0; color: var(--ink-2); font-size: 1rem; }

  /* AI */
  .ai {
    margin-top: 96px;
    padding: 88px 0;
    background: var(--ink);
    color: var(--bg);
  }
  :global(:root[data-theme='dark']) .ai { background: var(--bg-2); color: var(--ink); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ai { background: var(--bg-2); color: var(--ink); }
  }
  .ai-head { max-width: 780px; display: grid; gap: 16px; margin-bottom: 48px; }
  .section-num.on-blue { color: var(--lemon); }
  .ai-head h2 { margin: 0; font-size: clamp(2.1rem, 1.3rem + 3vw, 3.4rem); }
  .ai-head em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--lemon); letter-spacing: -0.01em; }
  .ai-head p { margin: 0; opacity: 0.8; font-size: 1.08rem; }
  .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    counter-reset: s;
  }
  @media (min-width: 720px) { .pipe { grid-template-columns: repeat(2, 1fr); } .pipe-step:last-child { grid-column: 1 / -1; } }
  @media (min-width: 1040px) { .pipe { grid-template-columns: repeat(5, 1fr); gap: 0; } .pipe-step:last-child { grid-column: auto; } }
  .pipe-step {
    position: relative;
    padding: 20px;
    border: 1.5px solid color-mix(in srgb, currentColor 30%, transparent);
    display: grid;
    gap: 6px;
    align-content: start;
  }
  @media (min-width: 1040px) {
    .pipe-step + .pipe-step { border-left: 0; }
    .pipe-step:not(:last-child)::after {
      content: '→';
      position: absolute;
      right: -11px;
      top: 18px;
      width: 22px;
      height: 22px;
      display: grid;
      place-items: center;
      background: var(--lemon);
      color: var(--lemon-ink);
      border-radius: 50%;
      font-family: var(--display);
      font-size: 0.8rem;
      font-weight: 700;
      z-index: 1;
    }
  }
  .pipe-n { font-family: var(--display); font-size: 0.75rem; opacity: 0.6; }
  .pipe-who {
    justify-self: start;
    font-family: var(--display);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .pipe-step.human .pipe-who { background: var(--lemon); color: var(--lemon-ink); border-color: var(--lemon); }
  .pipe-step h3 { margin: 8px 0 0; font-size: 1.3rem; }
  .pipe-step p { margin: 0; font-size: 0.95rem; opacity: 0.78; }

  /* MANUAL */
  .manual { display: grid; gap: 40px; }
  @media (min-width: 900px) {
    .manual { grid-template-columns: 340px 1fr; gap: 72px; }
    .manual-side { position: sticky; top: 32px; align-self: start; }
  }
  .manual-side { display: grid; gap: 14px; }
  .manual-side h2 { font-size: clamp(2.1rem, 1.3rem + 3vw, 3.4rem); margin: 0; }
  .manual-list { list-style: none; margin: 0; padding: 0; counter-reset: m; }
  .manual-list li {
    counter-increment: m;
    display: grid;
    grid-template-columns: 64px 1fr;
    column-gap: 16px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .manual-list li:last-child { border-bottom: 1px solid var(--line); }
  .manual-list li::before {
    content: counter(m);
    grid-row: span 2;
    font-family: var(--serif);
    font-style: italic;
    font-size: 3rem;
    line-height: 0.9;
    color: var(--blue);
  }
  .manual-list h3 { margin: 0 0 6px; font-size: 1.35rem; }
  .manual-list p { margin: 0; color: var(--ink-2); }

  /* EXPERIENCE */
  .cv { display: grid; gap: 48px; }
  @media (min-width: 960px) { .cv { grid-template-columns: 1.5fr 1fr; gap: 64px; } }
  .jobs { width: 100%; border-collapse: collapse; border-top: 1.5px solid var(--ink); }
  .jobs tr { border-bottom: 1px solid var(--line); transition: background 0.15s ease; }
  .jobs tr:hover { background: var(--bg-2); }
  .jobs td, .jobs th { padding: 14px 10px 14px 0; text-align: left; vertical-align: baseline; }
  .jobs .yrs { width: 112px; white-space: nowrap; }
  .jobs th { font-family: var(--display); font-weight: 650; font-size: 1.05rem; width: 120px; letter-spacing: -0.01em; }
  .jobs .role { color: var(--ink-2); font-size: 0.98rem; }
  @media (max-width: 640px) {
    .jobs tr { display: grid; grid-template-columns: 1fr auto; padding: 12px 0; }
    .jobs td, .jobs th { padding: 0; width: auto; }
    .jobs .yrs { grid-column: 2; grid-row: 1; text-align: right; }
    .jobs th { grid-row: 1; grid-column: 1; }
    .jobs .role { grid-column: 1 / -1; }
  }
  .teach { padding: 22px; box-shadow: 6px 6px 0 var(--lemon); }
  .teach p { margin: 12px 0 0; font-size: 1rem; }
  .side-h { font-size: 1.05rem; margin: 36px 0 6px; letter-spacing: -0.01em; }
  .edu { list-style: none; margin: 0; padding: 0; }
  .edu li { display: grid; gap: 2px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 0.98rem; }
  .edu strong { font-weight: 500; }

  /* OFF THE CLOCK */
  .off { display: grid; gap: 48px; }
  @media (min-width: 960px) { .off { grid-template-columns: 2fr 1fr; gap: 56px; } }
  .off-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 18px; gap: 12px; }
  .off-head h3 { margin: 0; font-size: 1.2rem; letter-spacing: -0.01em; }
  .recipes { display: grid; gap: 16px; }
  @media (min-width: 640px) { .recipes { grid-template-columns: repeat(3, 1fr); } }
  .recipe {
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    transform: rotate(var(--tilt, 0deg));
  }
  a.recipe:hover { transform: rotate(0deg) translate(-3px, -3px); }
  @media (max-width: 639px) { .recipe, a.recipe:hover { transform: none; } }
  .recipe .tag { align-self: flex-start; }
  .recipe h4 { margin: 4px 0 0; font-size: 1.3rem; }
  .recipe p { margin: 0; font-size: 0.95rem; color: var(--ink-2); flex: 1; }
  .shelf {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 260px;
    padding: 0 8px;
    border-bottom: 6px solid var(--ink);
    text-decoration: none;
  }
  .spine {
    flex: 1;
    height: var(--h);
    background: var(--c);
    color: var(--t);
    border: 1.5px solid var(--ink);
    border-bottom: 0;
    border-radius: 3px 3px 0 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 0;
    transition: transform 0.2s ease;
  }
  .spine:nth-child(3) { transform: rotate(-4deg); transform-origin: bottom left; }
  .shelf:hover .spine { transform: translateY(-6px); }
  .shelf:hover .spine:nth-child(3) { transform: rotate(-4deg) translateY(-6px); }
  .spine span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-height: 100%;
  }
</style>
