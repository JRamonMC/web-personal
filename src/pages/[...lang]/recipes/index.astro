---
import Base from '../../../layouts/Base.astro';
import { langPaths, localize, type Lang } from '../../../i18n';
import { ui } from '../../../i18n/ui';
import { recipesFor } from '../../../i18n/content';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const u = ui(lang);
const t = u.recipes;
const recipes = await recipesFor(lang);
---
<Base lang={lang} title={t.title} description={t.description}>
  <section class="section wrap">
    <div class="section-head">
      <span class="section-num">{t.kicker}</span>
      <h2>{t.h2}</h2>
      <p class="section-lead">{t.lead}</p>
    </div>
    <div class="grid">
      {recipes.map((r) => (
        <a class="card recipe" href={localize(lang, `/recipes/${r.slug}/`)}>
          <span class="tag">{r.data.tag}</span>
          <h3>{r.data.title}</h3>
          <p>{r.data.summary}</p>
          <span class="mono">{r.data.time} · {u.serves(r.data.serves)}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
<style>
  .grid { display: grid; gap: 16px; }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  .recipe { padding: 22px; display: flex; flex-direction: column; gap: 8px; }
  .recipe .tag { align-self: flex-start; }
  .recipe h3 { margin: 4px 0 0; font-size: 1.15rem; font-weight: 600; }
  .recipe p { margin: 0; color: var(--ink-2); flex: 1; font-size: 0.95rem; }
</style>
