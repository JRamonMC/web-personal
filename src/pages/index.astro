---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const recipes = (await getCollection('recipes'))
  .filter((r) => r.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const reading = await getCollection('reading');
const nowReading = reading.find((r) => r.data.current);
const shelf = reading.filter((r) => r.data.kind === 'book').slice(0, 6);

const now = [
  { k: 'Leading', v: 'An 11-person team at Letmino AI: backend, frontend and QA.' },
  { k: 'Building', v: 'A Software Factory to develop projects.' },
  { k: 'Teaching', v: 'Software Design Patterns at UOC, since 2024.' },
  { k: 'Reading', v: nowReading ? `${nowReading.data.title}, by ${nowReading.data.author}.` : 'Something good about teams.' },
];

/* ---------- Gráfico de flujo acumulado de la carrera ---------- */
// Reparto aproximado del tiempo por año (suma 100). Ajusta a tu gusto.
const bands = [
  { key: 'code', label: 'Writing software', color: '#eef0ff' },
  { key: 'data', label: 'Data & AI', color: '#9fe0ff' },
  { key: 'platform', label: 'Platform & reliability', color: '#8f99ff' },
  { key: 'teach', label: 'Teaching', color: '#7fd1a8' },
  { key: 'people', label: 'Leading people', color: '#e2ee4a' },
];
const years = [
  { y: 2018, code: 100, data: 0, platform: 0, teach: 0, people: 0, note: 'London' },
  { y: 2019, code: 92, data: 8, platform: 0, teach: 0, people: 0, note: 'AI for retail' },
  { y: 2020, code: 90, data: 10, platform: 0, teach: 0, people: 0, note: '' },
  { y: 2021, code: 82, data: 18, platform: 0, teach: 0, people: 0, note: 'Galp' },
  { y: 2022, code: 75, data: 20, platform: 5, teach: 0, people: 0, note: 'MSc' },
  { y: 2023, code: 40, data: 5, platform: 40, teach: 0, people: 15, note: 'Fresco' },
  { y: 2024, code: 15, data: 5, platform: 20, teach: 12, people: 48, note: 'UOC' },
  { y: 2025, code: 10, data: 8, platform: 12, teach: 10, people: 60, note: '' },
  { y: 2026, code: 30, data: 20, platform: 5, teach: 8, people: 37, note: 'Letmino AI' },
];
const W = 1000, H = 300, padX = 0;
const xs = years.map((_, i) => padX + (i * (W - padX * 2)) / (years.length - 1));
const curve = (pts: number[][]) => {
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 1; i < pts.length; i++) {
    const [x0, y0] = pts[i - 1];
    const [x1, y1] = pts[i];
    const mx = (x0 + x1) / 2;
    d += ` C${mx},${y0} ${mx},${y1} ${x1},${y1}`;
  }
  return d;
};
let acc = years.map(() => 0);
const areas = bands.map((b) => {
  const lower = acc.map((a, i) => [xs[i], H - (a / 100) * H]);
  acc = acc.map((a, i) => a + (years[i] as any)[b.key]);
  const upper = acc.map((a, i) => [xs[i], H - (a / 100) * H]);
  const top = curve(upper);
  const bottomRev = curve([...lower].reverse()).replace(/^M/, 'L');
  return { ...b, d: `${top} ${bottomRev} Z` };
});

const impact = [
  { stat: '5×', label: 'faster cycle time', text: 'Reworked how work flows through the team at Letmino AI, using cycle time, throughput and predictability to decide what to change next. Still improving.' },
  { stat: '11', label: 'people, one team', text: 'Backend, frontend and QA working as one unit. I own every person’s career progression, from 1:1s to growth plans.' },
  { stat: '3', label: 'teams at once', text: 'At Fresco I led KitchenOS, Foundations (Platform, SRE, DevEx) and Firmware, across software and hardware.' },
  { stat: 'Jr→P', label: 'career framework', text: 'Defined and rolled out Fresco’s engineering career paths, from Junior to Principal, so people knew what “next level” actually meant.' },
];

const pipeline = [
  { step: 'Ticket', who: 'Human', text: 'Well-scoped work, written so an agent can pick it up.' },
  { step: 'Draft', who: 'Agent', text: 'Agents take it from ticket to pull request inside our conventions.' },
  { step: 'First review', who: 'Agent', text: 'An AI pass catches the nits so people review design and risk.' },
  { step: 'Decide', who: 'Human', text: 'Engineers choose what goes in and what ships. Always.' },
  { step: 'Measure', who: 'Team', text: 'If cycle time and quality don’t move, it’s a toy.' },
];

const manual = [
  { title: 'Protect the zone', text: 'Fewer interruptions, clearer priorities, async by default. Deep work is the scarcest thing an engineering team has.' },
  { title: '1:1s are for growth', text: 'Not status updates. Every person has a direction and we talk about it often.' },
  { title: 'Learn from incidents', text: 'Blameless postmortems as a standard, so the same problem doesn’t surprise us twice.' },
  { title: 'Write decisions down', text: 'Architecture Decision Records and solution design documents keep the “why” around after the people in the meeting have moved on. I love a good document.' },
  { title: 'Kindness includes clarity', text: 'Clear expectations, direct feedback, and structured plans when performance needs them.' },
  { title: 'Processes serve people', text: 'If a ritual doesn’t help the team ship or grow, we drop it.' },
];

const jobs = [
  { org: 'Letmino AI', role: 'Engineering Manager', years: '2026 — now' },
  { org: 'UOC', role: 'Collaborator Professor, Design Patterns', years: '2024 — now' },
  { org: 'Fresco', role: 'Engineering Manager · KitchenOS, Foundations, Firmware', years: '2023 — 2025' },
  { org: 'Fresco', role: 'Platform Engineer · Platform, SRE & DevEx', years: '2023' },
  { org: 'Galp Solar', role: 'Software Engineer · Kotlin, CQRS, AWS', years: '2021 — 2023' },
  { org: 'KiKi', role: 'Software Engineer · React Native app in 20 countries', years: '2020 — 2021' },
  { org: 'RobinBrick', role: 'Software Engineer · AI for physical retail', years: '2019 — 2020' },
  { org: 'Gentrack', role: 'Software Engineer · London', years: '2018 — 2019' },
];

const education = [
  { org: 'University College Dublin', role: 'Diploma in Leadership and Management', years: '2025' },
  { org: 'UOC', role: 'MSc in Data Science', years: '2022' },
  { org: 'University of Murcia', role: 'Degree in Software Engineering', years: '2018' },
];

const notes = [
  { title: 'What actually moved our cycle time', kind: 'Field notes' },
  { title: 'Postmortems people want to attend', kind: 'Essay' },
  { title: 'Agentic development for an EM', kind: 'Deep dive' },
];

const spineColors = ['#2231d1', '#e2ee4a', '#0d0f30', '#7fd1a8', '#8f99ff', '#e6e5dc'];
const spineInk = ['#eef0ff', '#1a1d00', '#eef0ff', '#0d0f30', '#0d0f30', '#0d0f30'];
---
<Base>
  <!-- HERO -->
  <section class="hero wrap">
    <div class="hero-text">
      <p class="hero-kicker">
        <span class="status"><span class="pulse" aria-hidden="true"></span>Engineering Manager at {SITE.company}</span>
      </p>
      <h1>
        I help engineering teams stay in <span class="flow-word">flow</span>, and ship with AI&nbsp;agents.
      </h1>
    </div>
    <div class="hero-side">
      <p class="hero-lead">
        I’m José Ramón. I lead an 11-person team at <strong>Letmino AI</strong>, teach design patterns at <strong>UOC</strong>,
        and before that worked as an engineer in London, renewable energy and an IoT connected kitchen. I still
        remember how it feels to be pulled out of deep work, so I lead to protect it.
      </p>
      <dl class="now">
        {now.map((n) => (
          <div><dt class="label">{n.k}</dt><dd>{n.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- FLOW CHART -->
  <section class="wrap" aria-labelledby="flow-title">
    <figure class="flow">
      <figcaption class="flow-head">
        <div>
          <p class="flow-kicker">Cumulative flow, 2018 — 2026</p>
          <h2 id="flow-title">Where my time went.</h2>
        </div>
        <p class="flow-note">
          I measure teams with flow metrics, so here’s my own career as one.
          Hover a band.
        </p>
      </figcaption>
      <div class="chart">
        <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label="Stacked area chart: from mostly writing software in 2018 to leading people, teaching, AI work and writing software again in 2026.">
          {areas.map((a) => (
            <path d={a.d} fill={a.color} data-band={a.key} class="band" />
          ))}
          {xs.map((x, i) => i > 0 && i < xs.length - 1 && (
            <line x1={x} x2={x} y1="0" y2={H} class="grid" />
          ))}
        </svg>
        <ol class="years" aria-hidden="true">
          {years.map((y) => (
            <li><span class="yr">{y.y}</span>{y.note && <span class="yn">{y.note}</span>}</li>
          ))}
        </ol>
      </div>
      <ul class="legend">
        {bands.map((b) => (
          <li data-band={b.key}><span class="sw" style={`background:${b.color}`}></span>{b.label}</li>
        ))}
      </ul>
    </figure>
  </section>

  <!-- IMPACT -->
  <section id="work" class="section wrap">
    <div class="section-head">
      <span class="section-num">Impact</span>
      <h2>Results, not rituals.</h2>
      <p class="section-lead">A few things I’m proud of. The numbers matter less than what they changed for the people doing the work.</p>
    </div>
    <div class="ledger">
      {impact.map((i) => (
        <article class="ledger-row">
          <p class="stat">{i.stat}</p>
          <div>
            <h3>{i.label}</h3>
            <p>{i.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- AI -->
  <section id="ai" class="ai">
    <div class="wrap">
      <div class="ai-head">
        <span class="section-num on-blue">AI-native engineering</span>
        <h2>Building <em>with</em> agents, not just using them.</h2>
        <p>
          My way of staying close to the code today is designing how the team builds with AI, and AI has also brought me
          back to writing software myself. The model is only one piece. What really makes the difference is everything
          around it, like the context we give it, the conventions we agree on and the guardrails that keep it safe.
          My MSc in Data Science keeps me honest about evaluation.
        </p>
        <p>
          I like to learn as much as I can, but with AI everything changes every day. That’s why I keep an eye on the
          fundamentals. Architecture matters more than ever.
        </p>
      </div>
      <ol class="pipe">
        {pipeline.map((p, idx) => (
          <li class:list={['pipe-step', p.who.toLowerCase()]}>
            <span class="pipe-n">{String(idx + 1).padStart(2, '0')}</span>
            <span class="pipe-who">{p.who}</span>
            <h3>{p.step}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- MANUAL -->
  <section id="manual" class="section wrap">
    <div class="manual">
      <div class="manual-side">
        <span class="section-num">Working with me</span>
        <h2>A short user manual.</h2>
        <p class="section-lead">
          Many managers write a README so their team doesn’t have to guess. This is mine, in six lines.
        </p>
      </div>
      <ol class="manual-list">
        {manual.map((m) => (
          <li>
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- EXPERIENCE + TEACHING -->
  <section id="experience" class="section wrap">
    <div class="section-head">
      <span class="section-num">Experience</span>
      <h2>From backend to building teams.</h2>
    </div>
    <div class="cv">
      <table class="jobs">
        <tbody>
          {jobs.map((j) => (
            <tr>
              <td class="label yrs">{j.years}</td>
              <th scope="row">{j.org}</th>
              <td class="role">{j.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <aside class="cv-side">
        <div class="teach card">
          <span class="tag">Teaching</span>
          <p>
            Since 2024 I teach <strong>Analysis and Design with Patterns</strong> at the Universitat Oberta de Catalunya.
            Explaining a pattern to someone who has never needed it is the best test of whether I really get it.
          </p>
        </div>
        <h3 class="side-h">Education</h3>
        <ul class="edu">
          {education.map((e) => (
            <li><strong>{e.role}</strong><span class="label">{e.org} · {e.years}</span></li>
          ))}
        </ul>
        <h3 class="side-h">Writing, soon</h3>
        <ul class="edu">
          {notes.map((n) => (
            <li><strong>{n.title}</strong><span class="label">{n.kind} · in draft</span></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <!-- OFF THE CLOCK -->
  <section id="off" class="section wrap">
    <div class="section-head">
      <span class="section-num">Off the clock</span>
      <h2>Cooking, running, and the perfect coffee.</h2>
      <p class="section-lead">Cooking is the other place I find the zone. Same loop as work: try, taste, adjust.</p>
    </div>
    <div class="off">
      <div>
        <div class="off-head">
          <h3>From my kitchen</h3>
          <a class="link label" href={`${base}/recipes/`}>All recipes →</a>
        </div>
        <div class="recipes">
          {recipes.map((r, i) => (
            <a class="card recipe" href={`${base}/recipes/${r.id}/`} style={`--tilt:${[-1, 0.6, -0.4][i % 3]}deg`}>
              <span class="tag">{r.data.tag}</span>
              <h4>{r.data.title}</h4>
              <p>{r.data.summary}</p>
              <span class="label">{r.data.time} · serves {r.data.serves}</span>
            </a>
          ))}
        </div>
      </div>
      <div>
        <div class="off-head">
          <h3>On the shelf</h3>
          <a class="link label" href={`${base}/reading/`}>Reading list →</a>
        </div>
        <a class="shelf" href={`${base}/reading/`} aria-label="Go to reading list">
          {shelf.map((b, i) => (
            <span class="spine" style={`--c:${spineColors[i % 6]};--t:${spineInk[i % 6]};--h:${[92, 80, 100, 86, 95, 78][i % 6]}%`}>
              <span>{b.data.title}</span>
            </span>
          ))}
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Resaltar una banda del gráfico al pasar por la banda o la leyenda.
  const chart = document.querySelector('.flow');
  if (chart) {
    const set = (k: string | null) => chart.setAttribute('data-active', k ?? '');
    chart.querySelectorAll<HTMLElement | SVGElement>('[data-band]').forEach((el) => {
      el.addEventListener('mouseenter', () => set(el.getAttribute('data-band')));
      el.addEventListener('mouseleave', () => set(null));
    });
  }
</script>

<style>
  /* HERO */
  .hero {
    display: grid;
    gap: 40px;
    padding-top: 56px;
    padding-bottom: 56px;
  }
  @media (min-width: 980px) {
    .hero { grid-template-columns: 1.35fr 1fr; gap: 64px; align-items: end; padding-top: 88px; }
  }
  .hero-kicker { margin: 0 0 24px; }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 500;
    font-size: 0.88rem;
    padding: 6px 14px 6px 10px;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
  }
  .pulse {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--mint);
    animation: pulse 2.4s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--mint) 70%, transparent); }
    70% { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  h1 {
    font-size: clamp(2.7rem, 1.2rem + 5.4vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 0.98;
    margin: 0;
  }
  .flow-word { position: relative; color: var(--blue); white-space: nowrap; }
  .hero-lead { margin: 0 0 28px; font-size: 1.12rem; color: var(--ink-2); }
  .hero-lead strong { color: var(--ink); font-weight: 600; }
  .now { margin: 0; border-top: 1.5px solid var(--ink); }
  .now div {
    display: grid;
    grid-template-columns: 82px 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
  }
  .now dt { text-transform: uppercase; letter-spacing: 0.1em; padding-top: 3px; }
  .now dd { margin: 0; }

  /* FLOW CHART */
  .flow {
    margin: 0;
    background: var(--panel);
    color: var(--on-blue);
    padding: 28px 20px 22px;
    border-radius: 4px 40px 4px 4px;
  }
  @media (min-width: 720px) { .flow { padding: 40px 40px 28px; } }
  .flow-head { display: grid; gap: 12px; margin-bottom: 28px; }
  @media (min-width: 760px) { .flow-head { grid-template-columns: 1fr 320px; align-items: end; } }
  .flow-kicker { margin: 0 0 6px; font-family: var(--display); font-size: 0.78rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.12em; color: var(--lemon); }
  .flow-head h2 { margin: 0; font-size: clamp(1.9rem, 1.3rem + 2vw, 2.8rem); }
  .flow-note { margin: 0; color: var(--on-blue-2); font-size: 0.98rem; font-style: italic; }
  .chart svg { display: block; width: 100%; height: clamp(170px, 26vw, 300px); }
  .band { transition: opacity 0.2s ease; cursor: default; }
  .grid { stroke: var(--panel); stroke-width: 1; vector-effect: non-scaling-stroke; opacity: 0.35; }
  .flow[data-active]:not([data-active='']) .band { opacity: 0.25; }
  .flow[data-active='code'] .band[data-band='code'],
  .flow[data-active='data'] .band[data-band='data'],
  .flow[data-active='platform'] .band[data-band='platform'],
  .flow[data-active='teach'] .band[data-band='teach'],
  .flow[data-active='people'] .band[data-band='people'] { opacity: 1; }
  .years {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    justify-content: space-between;
    font-family: var(--display);
    font-size: 0.75rem;
  }
  .years li { display: flex; flex-direction: column; align-items: center; text-align: center; width: 0; white-space: nowrap; }
  .years li:first-child { align-items: flex-start; }
  .years li:last-child { align-items: flex-end; }
  .yr { font-weight: 600; font-variant-numeric: tabular-nums; }
  .yn { color: var(--on-blue-2); font-size: 0.7rem; }
  @media (max-width: 640px) {
    .yn { display: none; }
    .years li:nth-child(even) .yr { visibility: hidden; }
  }
  .legend {
    list-style: none;
    margin: 22px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid color-mix(in srgb, var(--on-blue) 25%, transparent);
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-family: var(--display);
    font-size: 0.85rem;
  }
  .legend li { display: flex; align-items: center; gap: 8px; cursor: default; }
  .sw { width: 14px; height: 14px; border-radius: 3px; }

  /* IMPACT */
  .ledger { display: grid; border-top: 1.5px solid var(--ink); }
  @media (min-width: 820px) { .ledger { grid-template-columns: 1fr 1fr; column-gap: 56px; } }
  .ledger-row {
    display: grid;
    grid-template-columns: minmax(110px, 0.6fr) 1fr;
    gap: 20px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    align-items: start;
  }
  .stat {
    margin: 0;
    font-family: var(--display);
    font-weight: 750;
    font-size: clamp(3rem, 2rem + 3vw, 4.6rem);
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--blue);
  }
  .ledger-row h3 { margin: 4px 0 8px; font-size: 1.25rem; }
  .ledger-row p:not(.stat) { margin: 0; color: var(--ink-2); font-size: 1rem; }

  /* AI */
  .ai {
    margin-top: 96px;
    padding: 88px 0;
    background: var(--ink);
    color: var(--bg);
  }
  :global(:root[data-theme='dark']) .ai { background: var(--bg-2); color: var(--ink); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .ai { background: var(--bg-2); color: var(--ink); }
  }
  .ai-head { max-width: 780px; display: grid; gap: 16px; margin-bottom: 48px; }
  .section-num.on-blue { color: var(--lemon); }
  .ai-head h2 { margin: 0; font-size: clamp(2.1rem, 1.3rem + 3vw, 3.4rem); }
  .ai-head em { font-family: var(--serif); font-style: italic; font-weight: 400; color: var(--lemon); letter-spacing: -0.01em; }
  .ai-head p { margin: 0; opacity: 0.8; font-size: 1.08rem; }
  .pipe {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    counter-reset: s;
  }
  @media (min-width: 720px) { .pipe { grid-template-columns: repeat(2, 1fr); } .pipe-step:last-child { grid-column: 1 / -1; } }
  @media (min-width: 1040px) { .pipe { grid-template-columns: repeat(5, 1fr); gap: 0; } .pipe-step:last-child { grid-column: auto; } }
  .pipe-step {
    position: relative;
    padding: 20px;
    border: 1.5px solid color-mix(in srgb, currentColor 30%, transparent);
    display: grid;
    gap: 6px;
    align-content: start;
  }
  @media (min-width: 1040px) {
    .pipe-step + .pipe-step { border-left: 0; }
    .pipe-step:not(:last-child)::after {
      content: '→';
      position: absolute;
      right: -11px;
      top: 18px;
      width: 22px;
      height: 22px;
      display: grid;
      place-items: center;
      background: var(--lemon);
      color: var(--lemon-ink);
      border-radius: 50%;
      font-family: var(--display);
      font-size: 0.8rem;
      font-weight: 700;
      z-index: 1;
    }
  }
  .pipe-n { font-family: var(--display); font-size: 0.75rem; opacity: 0.6; }
  .pipe-who {
    justify-self: start;
    font-family: var(--display);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 2px 8px;
    border-radius: 999px;
    border: 1px solid currentColor;
  }
  .pipe-step.human .pipe-who { background: var(--lemon); color: var(--lemon-ink); border-color: var(--lemon); }
  .pipe-step h3 { margin: 8px 0 0; font-size: 1.3rem; }
  .pipe-step p { margin: 0; font-size: 0.95rem; opacity: 0.78; }

